<?xml version="1.0"?>
<psalm
    errorLevel="5"
    resolveFromConfigFile="true"
    findUnusedBaselineEntry="true"
    findUnusedCode="false"
    phpVersion="8.2"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
>
    <projectFiles>
        <directory name="lib" />
        <ignoreFiles>
            <directory name="vendor" />
        </ignoreFiles>
    </projectFiles>
    <extraFiles>
        <directory name="vendor/nextcloud/ocp" />
    </extraFiles>
    <issueHandlers>
        <!-- Doctrine is shipped with Nextcloud server, not with nextcloud/ocp -->
        <UndefinedClass>
            <errorLevel type="suppress">
                <referencedClass name="Doctrine\DBAL\Types\Type" />
            </errorLevel>
        </UndefinedClass>
        <UndefinedDocblockClass>
            <errorLevel type="suppress">
                <referencedClass name="Doctrine\DBAL\Schema\Table" />
            </errorLevel>
        </UndefinedDocblockClass>
        <!-- #[\Override] needs PHP 8.3, the app supports PHP 8.1 -->
        <MissingOverrideAttribute errorLevel="suppress" />
        <MissingTemplateParam errorLevel="suppress" />
        <!-- integer parameters are fine, the docblock in IDBConnection is too strict -->
        <InvalidArgument>
            <errorLevel type="suppress">
                <referencedFunction name="OCP\IDBConnection::executeQuery" />
            </errorLevel>
        </InvalidArgument>
    </issueHandlers>
</psalm>
