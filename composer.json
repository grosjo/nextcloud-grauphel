{
    "name": "grosjo/nextcloud-grauphel",
    "description": "Tomboy REST API server to sync notes between devices",
    "type": "project",
    "license": "AGPL-3.0-or-later",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "nextcloud/ocp": "dev-stable34",
        "phpunit/phpunit": "^10.5",
        "vimeo/psalm": "^6.0"
    },
    "autoload": {
        "psr-4": {
            "OCA\\Grauphel\\": "lib/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.2.27"
        }
    },
    "scripts": {
        "lint": "find lib appinfo templates tests -name '*.php' -print0 | xargs -0 -n1 php -l",
        "psalm": "psalm --no-cache --threads=1",
        "test:unit": "phpunit -c tests/phpunit.xml"
    }
}
